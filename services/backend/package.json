    "passport": "^0.6.0",
    "passport-jwt": "^4.1.1",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.3.0",
    "@types/express": "^5.0.0",
